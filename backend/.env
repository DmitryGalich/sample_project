LISTEN_ADDRESS=0.0.0.0:8000

# URL для скачивания публичных ключей Keycloak (внутри Docker сети)
JWKS_URL=http://keycloak:8080/realms/sample_project_realm/protocol/openid-connect/certs

# Разрешенные издатели токенов (через запятую)
ALLOWED_ISSUERS=http://localhost/realms/sample_project_realm

# Разрешенные аудитории (через запятую)
ALLOWED_AUDIENCES=frontend,account

# Минимальный интервал обновления JWKS в секундах (флуд-контроль)
JWKS_MIN_REFRESH_INTERVAL_SECS=60
