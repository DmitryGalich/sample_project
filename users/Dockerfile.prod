# ==========================================
# Этап 1: Сборка всего приложения
# ==========================================
FROM rust:1.88-slim AS builder

# Устанавливаем системные зависимости (включая protobuf-compiler)
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем sqlx-cli
RUN cargo install sqlx-cli --version 0.7.4 --no-default-features --features native-tls,postgres

WORKDIR /workspace/users

# Копируем абсолютно весь проект для честной сборки с нуля
COPY Cargo.toml Cargo.lock build.rs ./
COPY proto ./proto
COPY src ./src
COPY migrations ./migrations

# Запускаем полную сборку (в продакшене для CI/CD это самый стабильный вариант без конфликтов путей)
RUN cargo build --release

# ==========================================
# Этап 2: Финальный минимальный образ для запуска
# ==========================================
FROM debian:bookworm-slim AS runner

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем бинарники и миграции
COPY --from=builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx
COPY --from=builder /workspace/users/target/release/users ./app_main
COPY --from=builder /workspace/users/migrations ./migrations

# Создаем entrypoint.sh
RUN echo '#!/bin/sh\n\
sqlx migrate run --database-url "$DATABASE_URL"\n\
exec ./app_main\n\
' > ./entrypoint.sh \
    && chmod +x ./entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
